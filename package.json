{
  "name": "pf-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PFT — Personal Finance Tracker (income & expense tracking)",
  "author": "PFT Studio",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:render": "node tests/render/run.mjs",
    "verify": "npm test && npm run test:render && npm run build",
    "icons": "node scripts/make-icons.cjs",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:all": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
